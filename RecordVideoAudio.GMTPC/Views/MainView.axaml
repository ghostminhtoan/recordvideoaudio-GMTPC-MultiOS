<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RecordVideoAudio.GMTPC.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
             x:Class="RecordVideoAudio.GMTPC.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0B0F19">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- ================= TOP HEADER BAR ================= -->
        <Border Grid.Row="0" Background="#131B2E" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="#1F2D4A" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20" Background="#1E293B" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="10" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#FF1744" />
                        </Border>
                        <TextBlock Text="{Binding AppTitleText}" FontSize="16" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" />
                        <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlatformBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#64B5F6" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SubtitleText}" FontSize="11" Foreground="#8892B0" Margin="32,2,0,0" />
                </StackPanel>

                <!-- Recording Status Badge -->
                <Border Grid.Column="2" CornerRadius="6" Padding="12,5" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{Binding StatusBadgeBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" 
                                 Fill="{Binding StatusBadgeColor}" />
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Language Toggle Button -->
                <Button Grid.Column="3" Command="{Binding ToggleLanguageCommand}"
                        Background="#1E293B" Foreground="#00F0FF" BorderBrush="#00F0FF" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentLanguageText}" />
                </Button>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY (2 COLUMNS) ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">

                <!-- ===== LEFT PANEL: VIDEO & RATE CONTROL STUDIO ===== -->
                <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,6,0">

                    <!-- Profile Presets -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🎯 CẤU HÌNH NHANH (PROFILES)" FontWeight="Bold" FontSize="12" Foreground="#FFB800" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Format & Codecs -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="📦 ĐỊNH DẠNG &amp; BỘ MÃ HÓA (CONTAINER &amp; CODECS)" FontWeight="Bold" FontSize="12" Foreground="#00F0FF" />

                            <!-- Container Format: MKV / MP4 -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding LabelContainerFormat}" FontSize="11" Foreground="#A0AEC0" />
                                    <ComboBox ItemsSource="{Binding FormatList}" SelectedItem="{Binding SelectedFormat}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Video Codec: H264 / HEVC -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding LabelVideoCodec}" FontSize="11" Foreground="#A0AEC0" />
                                    <ComboBox ItemsSource="{Binding VideoCodecList}" SelectedItem="{Binding SelectedVideoCodec}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <!-- Audio Codec: AAC / MP3 -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding LabelAudioCodec}" FontSize="11" Foreground="#A0AEC0" />
                                    <ComboBox ItemsSource="{Binding AudioCodecList}" SelectedItem="{Binding SelectedAudioCodec}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Hardware Acceleration -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding LabelHwAcceleration}" FontSize="11" Foreground="#A0AEC0" />
                                    <ComboBox ItemsSource="{Binding HwAccelList}" SelectedItem="{Binding SelectedHwAccel}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Rate Control Studio (CBR, VBR, CQP, CRF) -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="⚡ KIỂM SOÁT TỐC ĐỘ BIT (RATE CONTROL STUDIO)" FontWeight="Bold" FontSize="12" Foreground="#00E676" />

                            <!-- Mode Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding LabelRateControl}" FontSize="11" Foreground="#A0AEC0" />
                                <ComboBox ItemsSource="{Binding RateControlList}" SelectedItem="{Binding SelectedRateControl}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Dynamic Parameters -->
                            <!-- 1. CRF Slider -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsCrfMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Chỉ số chất lượng CRF (0 = Vô hao, 18-23 = Chuẩn nét, 51 = Thấp):" FontSize="11" Foreground="#A0AEC0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CrfValue}" FontWeight="Bold" Foreground="#00F0FF" />
                                </Grid>
                                <Slider Minimum="0" Maximum="51" Value="{Binding CrfValue}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            </StackPanel>

                            <!-- 2. CQP Slider -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsCqpMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Lượng tử hóa cố định CQP (GPU NVENC/QSV/AMF):" FontSize="11" Foreground="#A0AEC0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CqpValue}" FontWeight="Bold" Foreground="#FFB800" />
                                </Grid>
                                <Slider Minimum="0" Maximum="51" Value="{Binding CqpValue}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            </StackPanel>

                            <!-- 3. CBR / VBR Bitrate Slider -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsCbrMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Tốc độ bit cố định (CBR Bitrate):" FontSize="11" Foreground="#A0AEC0" />
                                    <TextBlock Grid.Column="1" Text="{Binding BitrateKbps, StringFormat='{}{0} kbps'}" FontWeight="Bold" Foreground="#00E676" />
                                </Grid>
                                <Slider Minimum="1000" Maximum="50000" Value="{Binding BitrateKbps}" TickFrequency="500" IsSnapToTickEnabled="True" />
                            </StackPanel>

                            <!-- 4. VBR Target & Max Bitrate Slider -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsVbrMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Bitrate mục tiêu (Target):" FontSize="11" Foreground="#A0AEC0" />
                                    <TextBlock Grid.Column="1" Text="{Binding BitrateKbps, StringFormat='{}{0} kbps'}" FontWeight="Bold" Foreground="#00E676" />
                                </Grid>
                                <Slider Minimum="1000" Maximum="50000" Value="{Binding BitrateKbps}" TickFrequency="500" IsSnapToTickEnabled="True" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock Text="Bitrate tối đa (Max Bitrate):" FontSize="11" Foreground="#A0AEC0" />
                                    <TextBlock Grid.Column="1" Text="{Binding MaxBitrateKbps, StringFormat='{}{0} kbps'}" FontWeight="Bold" Foreground="#FF1744" />
                                </Grid>
                                <Slider Minimum="2000" Maximum="80000" Value="{Binding MaxBitrateKbps}" TickFrequency="500" IsSnapToTickEnabled="True" />
                            </StackPanel>

                            <!-- FPS & Preset -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding LabelFps}" FontSize="11" Foreground="#A0AEC0" />
                                    <ComboBox ItemsSource="{Binding FpsList}" SelectedItem="{Binding SelectedFps}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding LabelPreset}" FontSize="11" Foreground="#A0AEC0" />
                                    <ComboBox ItemsSource="{Binding PresetList}" SelectedItem="{Binding SelectedPreset}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== RIGHT PANEL: CAPTURE SOURCE & AUDIO MIXER ===== -->
                <StackPanel Grid.Column="1" Spacing="12" Margin="6,0,0,0">

                    <!-- Capture Source -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🖥️ NGUỒN THU HÌNH (CAPTURE SOURCE)" FontWeight="Bold" FontSize="12" Foreground="#00F0FF" />
                            <ComboBox ItemsSource="{Binding CaptureSourceList}" SelectedItem="{Binding SelectedCaptureSource}"
                                      HorizontalAlignment="Stretch" />

                            <!-- 1. Custom Area Controls -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsCustomAreaMode}" Margin="0,4,0,0">
                                <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Button Content="🖱️ Kéo chuột quét chọn vùng trên màn hình..." Command="{Binding OpenRegionSelectorCommand}"
                                                Background="#1E3A5F" Foreground="#00F0FF" BorderBrush="#00F0FF" BorderThickness="1"
                                                FontWeight="SemiBold" FontSize="11" Padding="12,6" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,4" />

                                        <TextBlock Text="📐 TỌA ĐỘ VÀ KÍCH THƯỚC VÙNG QUAY" FontSize="11" FontWeight="Bold" Foreground="#64B5F6" />
                                        
                                        <!-- X & Y Offset -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                <TextBlock Text="Tọa độ X (Trục ngang):" FontSize="10" Foreground="#A0AEC0" />
                                                <NumericUpDown Minimum="0" Maximum="3840" Value="{Binding AreaX}" FormatString="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                <TextBlock Text="Tọa độ Y (Trục dọc):" FontSize="10" Foreground="#A0AEC0" />
                                                <NumericUpDown Minimum="0" Maximum="2160" Value="{Binding AreaY}" FormatString="0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Width & Height -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                <TextBlock Text="Chiều rộng (Width):" FontSize="10" Foreground="#A0AEC0" />
                                                <NumericUpDown Minimum="100" Maximum="7680" Value="{Binding AreaWidth}" FormatString="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                <TextBlock Text="Chiều cao (Height):" FontSize="10" Foreground="#A0AEC0" />
                                                <NumericUpDown Minimum="100" Maximum="4320" Value="{Binding AreaHeight}" FormatString="0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Presets -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="1080p (FullHD)" Command="{Binding SetPresetFhdCommand}"
                                                    Background="#1E293B" Foreground="#00F0FF" FontSize="10" Padding="8,4" CornerRadius="4" />
                                            <Button Content="720p (HD)" Command="{Binding SetPresetHdCommand}"
                                                    Background="#1E293B" Foreground="#00E676" FontSize="10" Padding="8,4" CornerRadius="4" />
                                            <Button Content="480p (SD)" Command="{Binding SetPresetSdCommand}"
                                                    Background="#1E293B" Foreground="#FFB800" FontSize="10" Padding="8,4" CornerRadius="4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 2. Active Window Controls -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsActiveWindowMode}" Margin="0,4,0,0">
                                <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="🪟 CHỌN CỬA SỔ PHẦN MỀM ĐANG MỞ" FontSize="11" FontWeight="Bold" Foreground="#64B5F6" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="🔄 Quét lại" Command="{Binding RefreshWindowsCommand}"
                                                    Background="#1E293B" Foreground="#00F0FF" FontSize="10" Padding="8,4" CornerRadius="4" />
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding OpenWindowsList}" SelectedItem="{Binding SelectedWindowTitle}"
                                                  HorizontalAlignment="Stretch" PlaceholderText="Chọn một cửa sổ ứng dụng để quay..." />
                                        <TextBlock Text="💡 Chỉ ghi hình nội dung bên trong cửa sổ đã chọn, không bị che khuất bởi cửa sổ khác."
                                                   FontSize="10" Foreground="#8892B0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. Camera PiP Controls -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsCameraPipMode}" Margin="0,4,0,0">
                                <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="📷 CẤU HÌNH WEBCAM OVERLAY (PICTURE-IN-PICTURE)" FontSize="11" FontWeight="Bold" Foreground="#64B5F6" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="🔄 Quét cam" Command="{Binding RefreshWebcamsCommand}"
                                                    Background="#1E293B" Foreground="#00F0FF" FontSize="10" Padding="8,4" CornerRadius="4" />
                                        </Grid>

                                        <!-- Select Webcam -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Thiết bị Webcam:" FontSize="10" Foreground="#A0AEC0" />
                                            <ComboBox ItemsSource="{Binding WebcamList}" SelectedItem="{Binding SelectedWebcam}"
                                                      HorizontalAlignment="Stretch" PlaceholderText="Chọn webcam..." />
                                        </StackPanel>

                                        <!-- Overlay Position & Size -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                <TextBlock Text="Vị trí góc hình:" FontSize="10" Foreground="#A0AEC0" />
                                                <ComboBox ItemsSource="{Binding PipPositionList}" SelectedItem="{Binding SelectedPipPosition}"
                                                          HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                <TextBlock Text="Kích thước camera:" FontSize="10" Foreground="#A0AEC0" />
                                                <ComboBox ItemsSource="{Binding PipSizeList}" SelectedItem="{Binding SelectedPipSize}"
                                                          HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="💡 Khung hình camera sẽ được chèn trực tiếp vào góc video màn hình theo thời gian thực."
                                                   FontSize="10" Foreground="#8892B0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dual Audio Mixer with OBS Multi-Track Matrix -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="🎚️ BÀN TRỘN ÂM THANH &amp; ĐỊNH TUYẾN TRACK OBS" FontWeight="Bold" FontSize="12" Foreground="#FFB800" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#1A00F0FF" CornerRadius="4" Padding="6,2" BorderBrush="#00F0FF" BorderThickness="1">
                                    <TextBlock Text="OBS MATRIX" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" />
                                </Border>
                            </Grid>

                            <!-- Channel 1: System Audio Loopback -->
                            <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Content="{Binding LabelSystemAudio}" IsChecked="{Binding SystemAudioEnabled}"
                                                  FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                                        <TextBlock Grid.Column="1" Text="{Binding SystemAudioVolume, StringFormat='{}{0}%'}" 
                                                   FontSize="11" FontWeight="Bold" Foreground="#00F0FF" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding SystemAudioVolume}" IsEnabled="{Binding SystemAudioEnabled}" />
                                    <!-- VU Meter Bar -->
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SystemAudioLevel}" Height="6"
                                                 Foreground="#00E676" Background="#1E293B" CornerRadius="3" />

                                    <!-- DSP Controls for Speaker: Sync Offset & Gain -->
                                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
                                        <!-- Sync Offset -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="⏱️ Lệch tiếng (Sync Offset):" FontSize="10" Foreground="#A0AEC0" />
                                                <Button Grid.Column="1" Content="0ms" Command="{Binding ResetSpeakerDspCommand}"
                                                        Background="Transparent" Foreground="#64B5F6" FontSize="9" Padding="4,0" BorderThickness="0"
                                                        ToolTip.Tip="Đặt lại lệch tiếng về 0ms" />
                                            </Grid>
                                            <NumericUpDown Minimum="-500" Maximum="1000" Value="{Binding SpeakerSyncOffsetMs}" Increment="10"
                                                           FormatString="0 ms" Height="26" FontSize="10" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="#1F2D4A" Margin="8,0" />

                                        <!-- Gain (dB) -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="🔊 Khuếch đại (Gain):" FontSize="10" Foreground="#A0AEC0" />
                                                <TextBlock Grid.Column="1" Text="{Binding SpeakerGainDisplay}" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" />
                                            </Grid>
                                            <Slider Minimum="-50" Maximum="50" Value="{Binding SpeakerGainDb}" TickFrequency="1" IsSnapToTickEnabled="False" Height="26" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Auto Ducking Speaker -->
                                    <Border Background="#10192D" CornerRadius="6" Padding="8,4" BorderBrush="#1F2D4A" BorderThickness="1" Margin="0,3,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <CheckBox Content="🦆 Tự giảm âm lượng Loa khi nói (Auto Ducking)" 
                                                      IsChecked="{Binding SpeakerAutoDucking}"
                                                      FontSize="10" Foreground="#00F0FF" FontWeight="SemiBold"
                                                      ToolTip.Tip="Tự động hạ nhỏ âm lượng loa khi micro đang thu tiếng nói/hát, tự phục hồi âm lượng gốc khi ngừng nói." />
                                            <TextBlock Grid.Column="1" Text="Loa -14dB" FontSize="9" FontWeight="Bold" Foreground="#64B5F6" VerticalAlignment="Center"
                                                       IsVisible="{Binding SpeakerAutoDucking}" />
                                        </Grid>
                                    </Border>

                                    <!-- OBS Track Matrix for Speaker -->
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                        <TextBlock Text="Định tuyến Audio Track:" FontSize="10" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <CheckBox Content="Track 1" IsChecked="{Binding SpeakerTrack1}" FontSize="10" Foreground="#00F0FF" FontWeight="Bold"
                                                      ToolTip.Tip="Phát tiếng Loa trong Track 1 (Mix cả 2)" />
                                            <CheckBox Content="Track 2" IsChecked="{Binding SpeakerTrack2}" FontSize="10" Foreground="#A0AEC0"
                                                      ToolTip.Tip="Phát tiếng Loa trong Track 2" />
                                            <CheckBox Content="Track 3" IsChecked="{Binding SpeakerTrack3}" FontSize="10" Foreground="#00E676" FontWeight="Bold"
                                                      ToolTip.Tip="Phát tiếng Loa riêng biệt trong Track 3 (System Audio độc lập)" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Channel 2: Microphone Input -->
                            <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Content="{Binding LabelMicrophone}" IsChecked="{Binding MicAudioEnabled}"
                                                  FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                                        <TextBlock Grid.Column="1" Text="{Binding MicAudioVolume, StringFormat='{}{0}%'}" 
                                                   FontSize="11" FontWeight="Bold" Foreground="#FFB800" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding MicAudioVolume}" IsEnabled="{Binding MicAudioEnabled}" />
                                    <!-- VU Meter Bar -->
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicAudioLevel}" Height="6"
                                                 Foreground="#FFB800" Background="#1E293B" CornerRadius="3" />

                                    <!-- DSP Controls for Microphone: Sync Offset & Gain (-50 dB to +50 dB) -->
                                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
                                        <!-- Sync Offset -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="⏱️ Lệch tiếng (Sync Offset):" FontSize="10" Foreground="#A0AEC0" />
                                                <Button Grid.Column="1" Content="0ms" Command="{Binding ResetMicDspCommand}"
                                                        Background="Transparent" Foreground="#64B5F6" FontSize="9" Padding="4,0" BorderThickness="0"
                                                        ToolTip.Tip="Đặt lại lệch tiếng về 0ms" />
                                            </Grid>
                                            <NumericUpDown Minimum="-500" Maximum="1000" Value="{Binding MicSyncOffsetMs}" Increment="10"
                                                           FormatString="0 ms" Height="26" FontSize="10" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="#1F2D4A" Margin="8,0" />

                                        <!-- Gain (dB) -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="🎙️ Khuếch đại Mic (Gain):" FontSize="10" Foreground="#A0AEC0" />
                                                <TextBlock Grid.Column="1" Text="{Binding MicGainDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFB800" />
                                            </Grid>
                                            <Slider Minimum="-50" Maximum="50" Value="{Binding MicGainDb}" TickFrequency="1" IsSnapToTickEnabled="False" Height="26" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Studio Vocal & Karaoke FX Studio Button (Gom toàn bộ hiệu ứng vào 1 nút) -->
                                    <Border Background="#131B2E" CornerRadius="8" Padding="10,8" BorderBrush="#00F0FF" BorderThickness="1.5" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="🎛️ VOCAL STUDIO &amp; KARAOKE FX" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" />
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" BorderBrush="#FFB800" BorderThickness="1"
                                                            IsVisible="{Binding HasActiveVocalFx}">
                                                        <TextBlock Text="{Binding VocalFxBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFB800" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding VocalFxStatusSummary}" FontSize="9" Foreground="#8892B0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Command="{Binding OpenVocalStudioCommand}"
                                                    Background="#00F0FF" Foreground="#0B0F19" FontWeight="Bold" FontSize="11"
                                                    Padding="12,6" CornerRadius="6" VerticalAlignment="Center"
                                                    ToolTip.Tip="Mở bàn điều khiển Vocal Studio FX: Echo, Reverb, Auto-Tune, Pitch Shifter, Lọc ồn AI &amp; Đo độ trễ">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="MỞ STUDIO FX" FontWeight="Bold" />
                                                    <TextBlock Text="⚙️" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- OBS Track Matrix for Microphone -->
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                        <TextBlock Text="Định tuyến Audio Track:" FontSize="10" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <CheckBox Content="Track 1" IsChecked="{Binding MicTrack1}" FontSize="10" Foreground="#00F0FF" FontWeight="Bold"
                                                      ToolTip.Tip="Phát tiếng Micro trong Track 1 (Mix cả 2)" />
                                            <CheckBox Content="Track 2" IsChecked="{Binding MicTrack2}" FontSize="10" Foreground="#FFB800" FontWeight="Bold"
                                                      ToolTip.Tip="Phát tiếng Micro riêng biệt trong Track 2 (Microphone độc lập)" />
                                            <CheckBox Content="Track 3" IsChecked="{Binding MicTrack3}" FontSize="10" Foreground="#A0AEC0"
                                                      ToolTip.Tip="Phát tiếng Micro trong Track 3" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Track Matrix Legend -->
                            <Border Background="#0D1322" CornerRadius="6" Padding="8,6" BorderBrush="#1F2D4A" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="📊 MA TRẬN TRACK XUẤT RA CHUẨN OBS STUDIO:" FontSize="10" FontWeight="Bold" Foreground="#64B5F6" />
                                    <TextBlock Text="• Track 1: Trộn chung (Mix Loa + Mic) để xem trực tiếp không cần chọn luồng." FontSize="10" Foreground="#CBD5E1" />
                                    <TextBlock Text="• Track 2: Chỉ tiếng Micro độc lập (Lọc tạp âm, lồng tiếng trong Premiere/CapCut)." FontSize="10" Foreground="#FFB800" />
                                    <TextBlock Text="• Track 3: Chỉ tiếng Loa / Game / Âm thanh máy (Cân chỉnh volume nền độc lập)." FontSize="10" Foreground="#00E676" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Utilities & Customizable Global Hotkeys Deck -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="⌨️ PHÍM TẮT TOÀN CỤC &amp; TIỆN ÍCH (GLOBAL SHORTCUTS)" FontWeight="Bold" FontSize="12" Foreground="#00E676" />

                            <Grid ColumnDefinitions="*,*">
                                <CheckBox Grid.Column="0" Content="Hiện Mini-Bar khi quay" IsChecked="{Binding AutoShowMiniBar}"
                                          FontSize="11" Foreground="#CBD5E1" />
                                <CheckBox Grid.Column="1" Content="Vẽ con trỏ chuột" IsChecked="{Binding DrawMouse}"
                                          FontSize="11" Foreground="#CBD5E1" />
                            </Grid>

                            <!-- Auto-stop timer -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Hẹn giờ tự động dừng quay (0 = Không giới hạn):" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <NumericUpDown Minimum="0" Maximum="480" Value="{Binding AutoStopMinutes}" FormatString="0" Width="100" />
                                    <TextBlock Text="phút" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Shortcut 1: Start / Stop Recording -->
                            <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="🔴 Phím tắt Bắt đầu / Dừng quay (Record / Stop):" FontSize="11" FontWeight="Bold" Foreground="#FF1744" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#22FF1744" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding RecordKeyName, StringFormat='Phím: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#FF5252" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                                        <CheckBox Grid.Column="0" Content="Ctrl" IsChecked="{Binding RecordCtrl}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,6,0" />
                                        <CheckBox Grid.Column="1" Content="Alt" IsChecked="{Binding RecordAlt}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,6,0" />
                                        <CheckBox Grid.Column="2" Content="Shift" IsChecked="{Binding RecordShift}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,6,0" />
                                        <CheckBox Grid.Column="3" Content="Win" IsChecked="{Binding RecordWin}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,8,0" />
                                        <TextBox x:Name="RecordKeyTextBox" Grid.Column="4" Text="{Binding RecordKeyName}"
                                                 KeyDown="OnRecordKeyKeyDown" TextChanged="OnRecordKeyTextChanged"
                                                 FontFamily="Consolas, Cascadia Code, Courier New" FontWeight="Bold" FontSize="11"
                                                 Foreground="#00F0FF" Background="#0A0E1A" BorderBrush="#00F0FF" BorderThickness="1"
                                                 CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 ToolTip.Tip="Nhấp vào đây và bấm bất kỳ phím nào (D0-D9, NumPad0-NumPad9, A-Z, F1-F12, dấu câu...)" />
                                        <Button Grid.Column="5" Content="Mặc định (D5)" Command="{Binding ResetRecordShortcutCommand}"
                                                Background="#1E293B" Foreground="#8892B0" FontSize="10" Padding="8,4" CornerRadius="4" Margin="6,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Shortcut 2: Pause / Resume Recording -->
                            <Border Background="#0D1322" CornerRadius="8" Padding="10" BorderBrush="#1F2D4A" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="⏸️ Phím tắt Tạm dừng / Tiếp tục (Pause / Resume):" FontSize="11" FontWeight="Bold" Foreground="#FFB800" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#22FFB800" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding PauseKeyName, StringFormat='Phím: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#FFD54F" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                                        <CheckBox Grid.Column="0" Content="Ctrl" IsChecked="{Binding PauseCtrl}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,6,0" />
                                        <CheckBox Grid.Column="1" Content="Alt" IsChecked="{Binding PauseAlt}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,6,0" />
                                        <CheckBox Grid.Column="2" Content="Shift" IsChecked="{Binding PauseShift}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,6,0" />
                                        <CheckBox Grid.Column="3" Content="Win" IsChecked="{Binding PauseWin}" FontSize="11" Foreground="#CBD5E1" Margin="0,0,8,0" />
                                        <TextBox x:Name="PauseKeyTextBox" Grid.Column="4" Text="{Binding PauseKeyName}"
                                                 KeyDown="OnPauseKeyKeyDown" TextChanged="OnPauseKeyTextChanged"
                                                 FontFamily="Consolas, Cascadia Code, Courier New" FontWeight="Bold" FontSize="11"
                                                 Foreground="#FFB800" Background="#0A0E1A" BorderBrush="#FFB800" BorderThickness="1"
                                                 CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 ToolTip.Tip="Nhấp vào đây và bấm bất kỳ phím nào (D0-D9, NumPad0-NumPad9, A-Z, F1-F12, dấu câu...)" />
                                        <Button Grid.Column="5" Content="Mặc định (D8)" Command="{Binding ResetPauseShortcutCommand}"
                                                Background="#1E293B" Foreground="#8892B0" FontSize="10" Padding="8,4" CornerRadius="4" Margin="6,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="💡 Tùy chỉnh tự do toàn bộ phím: Phân biệt tuyệt đối giữa dãy phím số trên (D0-D9) và bàn phím số phụ (NumPad0-NumPad9), chữ cái, phím chức năng F1-F12 và toàn bộ dấu câu."
                                       FontSize="10" Foreground="#8892B0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Realtime Command Pipeline Preview -->
                    <Border Background="#131B2E" CornerRadius="10" Padding="14" BorderBrush="#1F2D4A" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="💻 LỆNH PIPELINE THỜI GIAN THỰC (FFMPEG ENGINE)" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" />
                            </Grid>
                            <TextBox Text="{Binding CommandLinePreview}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="10" Height="70"
                                     Background="#0A0E1A" Foreground="#64B5F6" BorderBrush="#1F2D4A" CornerRadius="6" />
                        </StackPanel>
                    </Border>

                    <!-- Status Log Message -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="10" BorderBrush="#1E293B" BorderThickness="1">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ================= BOTTOM CONTROL DECK ================= -->
        <Border Grid.Row="2" Background="#131B2E" CornerRadius="10" Padding="16,12"
                BorderBrush="#1F2D4A" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- 1. Start / Stop Recording Button -->
                <Button Grid.Column="0" Command="{Binding StartRecordingCommand}" IsVisible="{Binding IsIdle}"
                        Background="#FF1744" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                        CornerRadius="8" Padding="20,10" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔴" />
                        <TextBlock Text="{Binding BtnStartText}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="0" Command="{Binding StopRecordingCommand}" IsVisible="{Binding !IsIdle}"
                        Background="#D50000" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                        CornerRadius="8" Padding="20,10" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⏹️" />
                        <TextBlock Text="{Binding BtnStopText}" />
                    </StackPanel>
                </Button>

                <!-- 2. Pause / Resume Button -->
                <Button Grid.Column="1" Command="{Binding TogglePauseResumeCommand}" IsEnabled="{Binding !IsIdle}"
                        Background="#1E293B" Foreground="#FFB800" FontWeight="SemiBold" FontSize="12"
                        CornerRadius="8" Padding="14,10" Margin="0,0,16,0" BorderBrush="#FFB800" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⏸️" />
                        <TextBlock Text="{Binding BtnPauseText}" />
                    </StackPanel>
                </Button>

                <!-- 3. Timer & Live Statistics -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <!-- Timer -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="THỜI GIAN QUAY" FontSize="9" FontWeight="Bold" Foreground="#8892B0" />
                        <TextBlock Text="{Binding ElapsedTimeString}" FontSize="22" FontWeight="Bold" 
                                   FontFamily="Consolas, Cascadia Code, Courier New" Foreground="#00F0FF" />
                    </StackPanel>

                    <!-- Estimated File Size -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="DUNG LƯỢNG" FontSize="9" FontWeight="Bold" Foreground="#8892B0" />
                        <TextBlock Text="{Binding FileSizeString}" FontSize="15" FontWeight="SemiBold" Foreground="#00E676" />
                    </StackPanel>

                    <!-- Current FPS -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="FPS HIỆN TẠI" FontSize="9" FontWeight="Bold" Foreground="#8892B0" />
                        <TextBlock Text="{Binding CurrentFpsString}" FontSize="15" FontWeight="SemiBold" Foreground="#FFB800" />
                    </StackPanel>

                    <!-- Frames Count -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="KHUNG HÌNH" FontSize="9" FontWeight="Bold" Foreground="#8892B0" />
                        <TextBlock Text="{Binding RecordedFramesString}" FontSize="13" Foreground="#CBD5E1" />
                    </StackPanel>
                </StackPanel>

                <!-- 4. Open Output Folder Button -->
                <Button Grid.Column="4" Command="{Binding OpenOutputFolderCommand}"
                        Background="#1E293B" Foreground="#64B5F6" BorderBrush="#1F2D4A" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📂" />
                        <TextBlock Text="{Binding BtnOpenFolderText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
