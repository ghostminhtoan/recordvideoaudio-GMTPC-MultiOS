<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordVideoAudio.GMTPC.ViewModels"
        x:Class="RecordVideoAudio.GMTPC.Views.FloatingMiniBarWindow"
        x:DataType="vm:MainViewModel"
        Title="GMTPC Recorder Mini Bar"
        Width="360" Height="52"
        WindowDecorations="None"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <Border Background="#F2131B2E" BorderBrush="#00F0FF" BorderThickness="1.5"
            CornerRadius="10" Padding="12,6" Cursor="Hand">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
            
            <!-- 1. Live Indicator & Timer -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="12" Height="12" Background="#1E293B" BorderBrush="#FF1744" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#FF1744" />
                </Border>
                <TextBlock Text="{Binding ElapsedTimeString}" FontSize="15" FontWeight="Bold"
                           FontFamily="Consolas, Cascadia Code, Courier New" Foreground="#00F0FF" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 2. Small Stats (FPS / Size) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentFpsString}" FontSize="10" Foreground="#FFB800" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="•" FontSize="10" Foreground="#8892B0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FileSizeString}" FontSize="10" Foreground="#00E676" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 3. Pause / Resume Button -->
            <Button Grid.Column="2" Command="{Binding TogglePauseResumeCommand}"
                    Background="#1E293B" Foreground="#FFB800" BorderBrush="#FFB800" BorderThickness="1"
                    CornerRadius="6" Padding="8,4" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                    ToolTip.Tip="Tạm dừng / Tiếp tục (F9)">
                <TextBlock Text="⏸️" />
            </Button>

            <!-- 4. Stop Recording Button -->
            <Button Grid.Column="3" Command="{Binding StopRecordingCommand}"
                    Background="#FF1744" Foreground="#FFFFFF" FontWeight="Bold"
                    CornerRadius="6" Padding="10,4" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                    ToolTip.Tip="Dừng quay và lưu (F8)">
                <TextBlock Text="⏹️ DỪNG" FontWeight="Bold" FontSize="10" />
            </Button>

            <!-- 5. Restore Main Window Button -->
            <Button Grid.Column="4" Command="{Binding RestoreMainWindowCommand}"
                    Background="#1E293B" Foreground="#64B5F6" BorderBrush="#1F2D4A" BorderThickness="1"
                    CornerRadius="6" Padding="8,4" FontSize="11" VerticalAlignment="Center"
                    ToolTip.Tip="Mở lại bảng điều khiển chính">
                <TextBlock Text="🗗" />
            </Button>

        </Grid>
    </Border>
</Window>
