<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordVideoAudio.GMTPC.ViewModels"
        xmlns:views="using:RecordVideoAudio.GMTPC.Views"
        x:Class="RecordVideoAudio.GMTPC.Views.VocalStudioWindow"
        x:DataType="vm:MainViewModel"
        Title="GMTPC VOCAL STUDIO &amp; KARAOKE FX RACK"
        Width="800" Height="640"
        MinWidth="740" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        CanResize="True"
        Background="#080C16">

    <views:VocalStudioControl />
</Window>
